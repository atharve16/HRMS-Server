# Runtime
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MongoDB Atlas (include retryWrites=true&w=majority for Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hrms

# Company rules
COMPANY_TIMEZONE=Asia/Kolkata
DEFAULT_GEOFENCE_RADIUS=100
MAX_GPS_ACCURACY=50
EMPLOYEE_CODE_PREFIX=EMP

# Attendance windows (minutes/hours)
ATTENDANCE_EARLY_CHECKIN_MINUTES=120
ATTENDANCE_LATE_CHECKIN_WINDOW_MINUTES=240
ATTENDANCE_OVERNIGHT_CHECKOUT_GRACE_MINUTES=240
ATTENDANCE_MAX_SESSION_DURATION_HOURS=24

# Authentication (use at least 32 cryptographically random bytes for JWT_SECRET)
JWT_SECRET=
JWT_ISSUER=hrms-backend
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=2592000000
OTP_HASH_SECRET=
OTP_EXPIRY=300000
OTP_RESEND_COOLDOWN=60000
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX_REQUESTS=10
OTP_RATE_LIMIT_WINDOW=300000
INITIAL_ADMIN_EMAIL=

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=HRMS

# Browser client / CORS
FRONTEND_URL=http://localhost:3000
REFRESH_COOKIE_NAME=hrms_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
